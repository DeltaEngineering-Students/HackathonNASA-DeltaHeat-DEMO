ene"}, {"year": 2023, "zone_lst": 39.55, "ref_lst": 29.23, "gap": 9.59, "ndvi": 0.413, "ndbi": -0.097, "built_share": 0.999, "scenes": 5, "valid_share": 1.0, "method": "per_scene"}, {"year": 2024, "zone_lst": 40.61, "ref_lst": 29.99, "gap": 10.46, "ndvi": 0.394, "ndbi": -0.07, "built_share": 0.999, "scenes": 3, "valid_share": 1.0, "method": "per_scene"}, {"year": 2025, "zone_lst": 34.66, "ref_lst": 29.9, "gap": 9.39, "ndvi": 0.427, "ndbi": -0.103, "built_share": 0.999, "scenes": 7, "valid_share": 1.0, "method": "per_scene"}], "gap_summary": {"mean": 9.49, "last": 9.39, "min": 7.74, "max": 10.46}, "trend": {"slope_per_decade": 0.72, "ci95": [-0.35, 2.31], "p": 0.077, "n_years": 13, "verdict": "not_significant"}, "ref_trend": {"slope_per_decade": 0.81, "ci95": [-1.01, 3.56], "p": 0.3, "n_years": 13, "verdict": "not_significant"}, "ndvi_trend": {"slope_per_decade": 0.079, "ci95": [0.043, 0.109], "p": 0.001, "n_years": 13, "verdict": "significant"}, "land_change": {"always_built": 3.024, "new_built": 0.036, "always_green": 0.0}, "green_gap": {"mean": 9.4, "last": 9.34, "scope": "urban_area", "trend": {"slope_per_decade": 0.52, "ci95": [-0.56, 1.95], "p": 0.246, "n_years": 13, "verdict": "not_significant"}}, "caveats": [{"code": "lst_not_air", "text_uk": "LST — це денна температура поверхні (знімок о ~10:30), а не температура повітря. Розрив поверхні зазвичай більший, ніж розрив повітря."}, {"code": "classes_extrapolated", "text_uk": "Карти забудови Esri є лише за 2017–2023; для 2013–2016, 2024, 2025 класи оцінено за зеленню (NDVI) і «бетонним» індексом (NDBI) відносно найближчого року Esri."}, {"code": "not_significant_physics", "text_uk": "«Поки не значущо» не означає «нічого не змінилось»: за 10–13 літ погода дає розкид ~1 °C, а тінь нових висоток о 10:30 і повільний ріст дерев глушать тренд. Дивіться також зміну зелені (NDVI) і забудови."}], "verdict_text_uk": "Позняки: забудова влітку вдень у середньому на 9,5 °C гарячіша за ліс навколо Києва. Тренд розриву 0,7 °C/10 р. поки не значущий (p = 0,08) — розрив стабільний або змінюється повільніше, ніж «шумить» погода. Територія зеленішає (NDVI, значущо). Зелень усередині міста на 9,4 °C прохолодніша за цю забудову.", "method": "per_scene", "years": [2013, 2025], "data_version": "l8c2l2-60m-2013-2025/sci-v1", "report_id": "1fb09f58a2eb7ea9", "params": {"note": "geometry omitted"}, "created_at": "2026-11-14T23:56:31Z", "compute_s": 0.391}