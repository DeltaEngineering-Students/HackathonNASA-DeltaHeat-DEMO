ся приблизно на 1 °C, а тінь нових висоток зранку і повільний ріст дерев приховують зміну. Подивіться також, як змінилися зелень і забудова."}], "verdict_text_uk": "Поверхня забудови влітку вдень у середньому на 8,0 °C гарячіша, ніж ліс навколо Харкова, і за 13 літ цей розрив помітно не змінився (поки не значуще, p = 1,00). Парки й сквери всередині міста на 5,6 °C прохолодніші за цю забудову.", "method": "per_scene", "years": [2013, 2025], "data_version": "l8c2l2-60m-2013-2025/sci-v3", "method_version": "sci-v3.3", "report_id": "754064a7fd859fb3", "params": {"geometry_hash": "13bf4adf5fdde304", "years": [2013, 2025], "place_id": "kharkiv-saltivka", "data_version": "l8c2l2-60m-2013-2025/sci-v3", "method_version": "sci-v3.3", "api_version": "0.1.0", "schema": "r2"}, "created_at": "2026-11-15T01:30:16Z", "compute_s": 0.845}, {"zone": {"name": "Дарницький район (Київ)", "area_km2": 127.555, "built_area_km2": 54.353, "analysed": "built", "basis": "always_built", "analysed_area_km2": 50.702, "clipped_km2": null, "war_region": null, "city": "kyiv"}, "reference": {"city": "kyiv", "ring_km": [2.0, 15.0], "area_km2": 354.0, "forest_px": 98333, "kind": "preset", "urban_area_km2": 827.9}, "series": [{"year": 2013, "zone_lst": 37.4, "ref_lst": 29.43, "gap": 7.97, "ndvi": 0.656, "ndbi": -0.266, "built_share": 0.447, "scenes": 2, "valid_share": 0.986, "method": "per_scene", "excluded": null}, {"year": 2014, "zone_lst": 37.19, "ref_lst": 28.22, "gap": 8.97, "ndvi": 0.66, "ndbi": -0.268, "built_share": 0.446, "scenes": 2, "valid_share": 1.0, "method": "per_scene", "excluded": null}, {"year": 2015, "zone_lst": 36.71, "ref_lst": 29.13, "gap": 7.58, "ndvi": 0.63, "ndbi": -0.24, "built_share": 0.45, "scenes": 2, "valid_share": 1.0, "method": "per_scene", "excluded": null}, {"year": 2016, "zone_lst": 35.82, "ref_lst": 27.9, "gap": 7.92, "ndvi": 0.644, "ndbi": -0.24, "built_share": 0.452, "scenes": 4, "valid_share": 1.0, "method": "per_scene", "excluded": null}, {"year": 2017, "zone_lst":