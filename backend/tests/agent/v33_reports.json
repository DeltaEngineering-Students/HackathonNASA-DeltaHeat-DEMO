ва."}], "verdict_text_uk": "Поверхня забудови влітку вдень у середньому на 5,0 °C гарячіша, ніж ліс навколо Києва, і за 13 літ цей розрив помітно не змінився (поки не значуще, p = 0,81). Там, де за ці роки з’явилась нова забудова (≈0,9 км²), поверхня стала гарячішою: розрив із лісом був 4,2 °C у 2013–2014 р., а став 5,8 °C у 2024–2025 р. Парки й сквери всередині міста на 3,3 °C прохолодніші за цю забудову.", "method": "per_scene", "years": [2013, 2025], "data_version": "l8c2l2-60m-2013-2025/sci-v3", "method_version": "sci-v3.3", "report_id": "45b737b3ea8e78af", "params": {"geometry_hash": "2245079264529400", "years": [2013, 2025], "place_id": "kyiv-hatne", "data_version": "l8c2l2-60m-2013-2025/sci-v3", "method_version": "sci-v3.3", "api_version": "0.1.0", "schema": "r2"}, "created_at": "2026-11-15T01:28:12Z", "compute_s": 1.189}, {"zone": {"name": "Салтівка", "area_km2": 18.008, "built_area_km2": 17.572, "analysed": "built", "basis": "always_built", "analysed_area_km2": 16.992, "clipped_km2": null, "war_region": null, "city": "kharkiv"}, "reference": {"city": "kharkiv", "ring_km": [2.0, 15.0], "area_km2": 274.8, "forest_px": 76327, "kind": "preset", "urban_area_km2": 351.0}, "series": [{"year": 2013, "zone_lst": 34.94, "ref_lst": 27.08, "gap": 7.86, "ndvi": 0.552, "ndbi": -0.151, "built_share": 0.961, "scenes": 7, "valid_share": 1.0, "method": "per_scene", "excluded": null}, {"year": 2014, "zone_lst": 35.26, "ref_lst": 29.12, "gap": 6.14, "ndvi": 0.562, "ndbi": -0.158, "built_share": 0.96, "scenes": 9, "valid_share": 1.0, "method": "per_scene", "excluded": null}, {"year": 2015, "zone_lst": 37.08, "ref_lst": 28.21, "gap": 8.87, "ndvi": 0.556, "ndbi": -0.149, "built_share": 0.967, "scenes": 5, "valid_share": 1.0, "method": "per_scene", "excluded": null}, {"year": 2016, "zone_lst": 32.21, "ref_lst": 24.4, "gap": 7.81, "ndvi": 0.559, "ndbi": -0.176, "built_share": 0.967, "scenes": 3, "valid_share": 1.0, "method": "per_scene", "excluded": null}, {"year": 2017, "zone_lst"